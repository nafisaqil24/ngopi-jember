# Production Environment Variables
# Copy to .env and fill in ALL values before deploying

# Database (Neon/PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require&channel_binding=require"

# Server
PORT=4000
NODE_ENV="production"

# Frontend URL (exact production domain, no trailing slash)
CLIENT_URL="https://yourdomain.com"

# JWT Secret - MINIMUM 32 CHARACTERS, generate with: openssl rand -base64 48
JWT_SECRET="your-super-secret-random-string-min-32-chars"

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Admin account - SET THESE BEFORE FIRST DEPLOY
# This admin will be created via script, NOT via seed
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_NAME="Admin Name"
ADMIN_PASSWORD="strong-random-password-min-12-chars"

# DO NOT SET SEED_* variables in production
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=
# SEED_OWNER_EMAIL=
# SEED_OWNER_PASSWORD=
# SEED_OWNER_NAME=