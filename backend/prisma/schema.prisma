generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String       @id @default(cuid())
  name        String
  email       String       @unique
  password    String
  role        UserRole     @default(USER)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  coffeeShops CoffeeShop[]
  reviews     Review[]
}

model CoffeeShop {
  id              String               @id @default(cuid())
  ownerId         String
  name            String
  slug            String               @unique
  description     String
  address         String
  district        String
  latitude        Float?
  longitude       Float?
  phone           String?
  instagram       String?
  priceRange      String
  openingHours    String
  status          CoffeeShopStatus     @default(OPEN)
  isVerified      Boolean              @default(false)
  isFeatured      Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  analyticsEvents AnalyticsEvent[]
  owner           User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories      CoffeeShopCategory[]
  facilities      CoffeeShopFacility[]
  images          CoffeeShopImage[]
  menus           Menu[]
  promotions      Promotion[]
  reviews         Review[]
  subscription    Subscription?

  @@index([district])
  @@index([isFeatured, createdAt])
}

model Category {
  id          String               @id @default(cuid())
  name        String               @unique
  slug        String               @unique
  coffeeShops CoffeeShopCategory[]
}

model Facility {
  id          String               @id @default(cuid())
  name        String               @unique
  slug        String               @unique
  coffeeShops CoffeeShopFacility[]
}

model CoffeeShopCategory {
  coffeeShopId String
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  coffeeShop   CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)

  @@id([coffeeShopId, categoryId])
}

model CoffeeShopFacility {
  coffeeShopId String
  facilityId   String
  coffeeShop   CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
  facility     Facility   @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@id([coffeeShopId, facilityId])
}

model Menu {
  id           String     @id @default(cuid())
  coffeeShopId String
  name         String
  description  String?
  price        Int
  image        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  category     String?
  coffeeShop   CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
}

model CoffeeShopImage {
  id           String     @id @default(cuid())
  coffeeShopId String
  imageUrl     String
  createdAt    DateTime   @default(now())
  coffeeShop   CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
}

model Review {
  id           String     @id @default(cuid())
  coffeeShopId String
  userId       String
  rating       Int
  comment      String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  coffeeShop   CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([coffeeShopId, userId])
}

model Promotion {
  id           String     @id @default(cuid())
  coffeeShopId String
  title        String
  description  String
  image        String?
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  coffeeShop   CoffeeShop @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id           String             @id @default(cuid())
  coffeeShopId String
  eventType    AnalyticsEventType
  createdAt    DateTime           @default(now())
  coffeeShop   CoffeeShop         @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)

  @@index([coffeeShopId, eventType, createdAt])
}

model Subscription {
  id           String             @id @default(cuid())
  coffeeShopId String             @unique
  plan         SubscriptionPlan   @default(FREE)
  startDate    DateTime
  endDate      DateTime?
  status       SubscriptionStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  coffeeShop   CoffeeShop         @relation(fields: [coffeeShopId], references: [id], onDelete: Cascade)
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum CoffeeShopStatus {
  OPEN
  CLOSED
  TEMPORARILY_CLOSED
}

enum AnalyticsEventType {
  PROFILE_VIEW
  MAP_CLICK
  WHATSAPP_CLICK
  INSTAGRAM_CLICK
  MENU_VIEW
  PROMOTION_VIEW
}

enum SubscriptionPlan {
  FREE
  FEATURED
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}
