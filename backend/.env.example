# Development Environment Variables
# Copy to .env and fill in values

# Database (Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ngopi_jember?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ngopi_jember?schema=public"

# Server
PORT=4000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"

# JWT Secret - generate with: openssl rand -base64 48
JWT_SECRET="ganti-dengan-random-string-minimal-32-karakter"

# Cloudinary (optional for dev)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Seed variables (OPTIONAL - only for development seeding)
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_NAME=""
# SEED_OWNER_EMAIL=""
# SEED_OWNER_PASSWORD=""
# SEED_OWNER_NAME=""

# Production admin (NOT for seed, used by create-admin script)
# ADMIN_EMAIL=""
# ADMIN_NAME=""
# ADMIN_PASSWORD=""

# Chatbot LLM (Groq / OpenAI compatible)
LLM_API_KEY=""
LLM_BASE_URL="https://api.groq.com/openai/v1"
LLM_MODEL=""
LLM_TIMEOUT_MS="10000"
CHAT_DAILY_LIMIT="800"
